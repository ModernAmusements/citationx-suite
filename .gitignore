# Track only the first-party Citation X suite inside this live FlyWithLua install.
# Everything else is third-party plugin data or runtime state.
/*
!/.gitignore
!/README.md
!/CONTEXT.md
!/SCRIPT_STATUS.md
!/CONTROLLER.md

# Citation X Lua scripts (live in the sim's Scripts folder)
!/Scripts/
/Scripts/*
!/Scripts/CitationX_*.lua
!/Scripts/CitationX_Callouts/
/Scripts/CitationX_Callouts/*
!/Scripts/CitationX_Callouts/*.wav

# Mock-FlyWithLua test harnesses
!/tests/
/tests/*
!/tests/*.lua

# Offline joystick profile mapper (works with X-Plane closed)
!/tools/
/tools/*
!/tools/*.py
!/tools/render_panels.lua

# README screenshots (panel renders + texture before/after captures)
!/docs/
/docs/*
!/docs/img/
/docs/img/*
!/docs/img/panels/
/docs/img/panels/*
!/docs/img/panels/*.png
!/docs/img/textures/
/docs/img/textures/*
!/docs/img/textures/*.png

# Credentials, tokens and machine-local secrets — never published.
.env
.env.*
*.env
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
.netrc
.npmrc
.pypirc
.git-credentials
credentials
credentials.*
secrets
secrets.*
*.token
*.secret
auth.json
service.json
cli.json
opencode.json
opencode.json.*
*.local

# AI agent / assistant configuration — local only, never published.
.opencode/
AGENTS.md
CLAUDE.md
GEMINI.md
.cursor/
.cursorrules
.claude/
.aider*
.windsurf/
.mcp.json
.github/copilot-instructions.md

# Editor and OS local state.
.vscode/
.idea/
.DS_Store
